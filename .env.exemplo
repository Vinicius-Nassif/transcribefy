# Copie para .env e ajuste o que precisar: `cp .env.exemplo .env`.
# O .env não é versionado — é onde mora o que muda de máquina para máquina.

# Onde a interface web escuta. O padrão só aceita conexões da própria máquina;
# para alcançá-la de outro computador da rede, use apenas a porta (ex.: 8000).
# Lembre que a página não tem autenticação nenhuma.
#TRANSCRIBEFY_BIND=127.0.0.1:8000

# Pastas do host. Aceitam caminhos absolutos — inclusive do Windows pelo WSL,
# como /mnt/c/Users/<voce>/Documents/sessoes.
#TRANSCRIBEFY_MIDIA=./midia
#TRANSCRIBEFY_DADOS=./dados
#TRANSCRIBEFY_SAIDA=./saida

# Dono dos arquivos gerados. Confira o seu com `id -u` e `id -g`.
#TRANSCRIBEFY_UID=1000
#TRANSCRIBEFY_GID=1000
